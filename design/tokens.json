{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "FarmerApp design tokens derived from SPEC §13.1. Themes: light (default), sunlight (mobile high-contrast), dark (web console). Semantic names; tenant may override color.primary.* and brand.logo.",
  "color": {
    "primary": {
      "default": { "$type": "color", "$value": "#1F6B3A", "$extensions": { "theme": { "sunlight": "#134A27", "dark": "#5DBB7E" } } },
      "hover": { "$type": "color", "$value": "#185630", "$extensions": { "theme": { "sunlight": "#0E361C", "dark": "#7BCB96" } } },
      "container": { "$type": "color", "$value": "#DCEFE2", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#1E3A2A" } } },
      "on": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#0B1A10" } } }
    },
    "secondary": {
      "default": { "$type": "color", "$value": "#E0A21B", "$extensions": { "theme": { "sunlight": "#8A6000", "dark": "#F0BE4E" } } },
      "container": { "$type": "color", "$value": "#FBEFCF", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#3A2E10" } } },
      "on": { "$type": "color", "$value": "#3A2A00", "$description": "NF-009: sunlight uses white on the dark amber (5.59:1); black was 3.75:1.", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#1A1400" } } }
    },
    "text": {
      "default": { "$type": "color", "$value": "#2B2520", "$extensions": { "theme": { "sunlight": "#000000", "dark": "#F2EEE7" } } },
      "secondary": { "$type": "color", "$value": "#5E554C", "$extensions": { "theme": { "sunlight": "#000000", "dark": "#C9C2B8" } } },
      "muted": { "$type": "color", "$value": "#756C64", "$description": "NF-009: 4.80:1 on background (was #8A8076 at 3.61:1, below AA for body text).", "$extensions": { "theme": { "sunlight": "#333333", "dark": "#9A9188" } } }
    },
    "border": {
      "default": { "$type": "color", "$value": "#E3DDD3", "$description": "Decorative hairline between rows and around cards. WCAG 1.4.11 does not apply: it carries no state.", "$extensions": { "theme": { "sunlight": "#000000", "dark": "#3A3631" } } },
      "strong": { "$type": "color", "$value": "#6B635B", "$description": "NF-009 / WCAG 1.4.11: the boundary of an interactive control (text field, outlined button). 5.51:1 in light, 4.06:1 in dark, black in sunlight.", "$extensions": { "theme": { "sunlight": "#000000", "dark": "#8A8078" } } }
    },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#1E1C19" } } },
    "background": { "$type": "color", "$value": "#FAF7F0", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#151412" } } },
    "status": {
      "success": { "$type": "color", "$value": "#26702C", "$description": "NF-009: 5.30:1 on successContainer (was #2E7D32 at 4.45:1).", "$extensions": { "theme": { "sunlight": "#1B5E20", "dark": "#66BB6A" } } },
      "successContainer": { "$type": "color", "$value": "#E3F3E4", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#1B3A1E" } } },
      "warning": { "$type": "color", "$value": "#8A5200", "$description": "NF-009: 5.58:1 on warningContainer (was #B26A00 at 3.70:1).", "$extensions": { "theme": { "sunlight": "#7A4800", "dark": "#E0A21B" } } },
      "warningContainer": { "$type": "color", "$value": "#FBEFCF", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#3A2E10" } } },
      "danger": { "$type": "color", "$value": "#C62828", "$description": "NF-009: dark raised to #F4706D, 5.37:1 on dangerContainer (was #EF5350 at 4.38:1).", "$extensions": { "theme": { "sunlight": "#8E1B1B", "dark": "#F4706D" } } },
      "dangerContainer": { "$type": "color", "$value": "#FBE4E4", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#3F1A1A" } } },
      "info": { "$type": "color", "$value": "#1565C0", "$extensions": { "theme": { "sunlight": "#0D47A1", "dark": "#64B5F6" } } },
      "infoContainer": { "$type": "color", "$value": "#E1ECF9", "$extensions": { "theme": { "sunlight": "#FFFFFF", "dark": "#15294A" } } }
    },
    "confidence": {
      "high": { "$type": "color", "$value": "{color.status.success}" },
      "medium": { "$type": "color", "$value": "{color.status.warning}" },
      "low": { "$type": "color", "$value": "{color.text.muted}", "$description": "Provisional: neutral grey with dashed border" }
    },
    "visit": {
      "verified": { "$type": "color", "$value": "{color.status.success}" },
      "partial": { "$type": "color", "$value": "{color.status.warning}" },
      "unverified": { "$type": "color", "$value": "{color.status.danger}", "$description": "Outline style" }
    }
  },
  "font": {
    "family": {
      "latin": { "$type": "fontFamily", "$value": ["Noto Sans", "system-ui", "sans-serif"] },
      "telugu": { "$type": "fontFamily", "$value": ["Noto Sans Telugu", "Noto Sans", "sans-serif"] },
      "kannada": { "$type": "fontFamily", "$value": ["Noto Sans Kannada", "Noto Sans", "sans-serif"] },
      "devanagari": { "$type": "fontFamily", "$value": ["Noto Sans Devanagari", "Noto Sans", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "features": { "$type": "string", "$value": "tnum", "$description": "Tabular figures for numbers" }
  },
  "text": {
    "mobile": {
      "display": { "$type": "typography", "$value": { "fontSize": "28sp", "lineHeight": "36sp", "fontWeight": 600 } },
      "title": { "$type": "typography", "$value": { "fontSize": "22sp", "lineHeight": "30sp", "fontWeight": 600 } },
      "heading": { "$type": "typography", "$value": { "fontSize": "18sp", "lineHeight": "26sp", "fontWeight": 600 } },
      "body": { "$type": "typography", "$value": { "fontSize": "16sp", "lineHeight": "24sp", "fontWeight": 400 } },
      "label": { "$type": "typography", "$value": { "fontSize": "14sp", "lineHeight": "20sp", "fontWeight": 600 } },
      "caption": { "$type": "typography", "$value": { "fontSize": "12sp", "lineHeight": "16sp", "fontWeight": 400 } },
      "indicLineHeightMultiplier": { "$type": "number", "$value": 1.15 }
    },
    "console": {
      "display": { "$type": "typography", "$value": { "fontSize": "28px", "lineHeight": "36px", "fontWeight": 600 } },
      "title": { "$type": "typography", "$value": { "fontSize": "22px", "lineHeight": "30px", "fontWeight": 600 } },
      "heading": { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600 } },
      "body": { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400 } },
      "small": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4" },
    "2": { "$type": "dimension", "$value": "8" },
    "3": { "$type": "dimension", "$value": "12" },
    "4": { "$type": "dimension", "$value": "16" },
    "6": { "$type": "dimension", "$value": "24" },
    "8": { "$type": "dimension", "$value": "32" },
    "12": { "$type": "dimension", "$value": "48" },
    "screenPadding": { "$type": "dimension", "$value": "16" }
  },
  "radius": {
    "input": { "$type": "dimension", "$value": "8" },
    "chip": { "$type": "dimension", "$value": "8" },
    "card": { "$type": "dimension", "$value": "12" },
    "sheet": { "$type": "dimension", "$value": "16" },
    "pill": { "$type": "dimension", "$value": "9999" }
  },
  "size": {
    "touchTargetMin": { "$type": "dimension", "$value": "48" },
    "primaryButtonHeight": { "$type": "dimension", "$value": "56" },
    "icon": { "$type": "dimension", "$value": "24" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1", "$extensions": { "theme": { "sunlight": "2" } } }
  },
  "elevation": {
    "flat": { "$type": "shadow", "$value": "none" },
    "sheet": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "4", "blur": "16", "spread": "0", "color": "#00000029" } }
  }
}
