{
  "name": "@farmerapp/console",
  "version": "0.1.0",
  "private": true,
  "description": "FarmerApp web console (owners and managers) — Next.js App Router, TypeScript strict, Tailwind, shadcn/ui, TanStack Query.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/tokens-to-css.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/lint-strings.mjs",
    "lint:strings": "node scripts/lint-strings.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens-to-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
