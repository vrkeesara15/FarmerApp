# Base URL of the FarmerApp API. Leave unset to use the in-app mock at /api/mock (used by Playwright smoke tests).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: fail `npm run size` if total static JS+CSS exceeds this many KB.
SIZE_LIMIT_KB=
# Optional: map tile URL template for every console map (default OpenStreetMap raster tiles).
NEXT_PUBLIC_MAP_TILE_URL=
