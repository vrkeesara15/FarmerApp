# FarmerApp local environment. Copy to .env (git-ignored). Every variable the code reads is
# listed here. NEVER put real credentials in this file: prod values live in Secret Manager
# and are injected into the container environment by Terraform (SEC-013).

# --- Runtime ---------------------------------------------------------------
APP_ENV=local                 # local | test | dev | stg | prd
SERVICE_NAME=api              # api | worker | jobs | migrate (log field; scopes the prd guard rails)
LOG_LEVEL=INFO
LOG_JSON=false                # true = JSON lines (Cloud Logging); false = coloured console

# --- Database (docker compose db; dev-only credentials) ----------------------
DB_PORT=5432                  # host port for the compose db; change if a local Postgres owns 5432
# Two roles (SEC-011): the runtime connects as farmerapp_app (DML only, row-level security);
# Alembic runs as the owner. Keep the port in sync with DB_PORT.
DATABASE_URL=postgresql+asyncpg://farmerapp_app:farmerapp@localhost:5432/farmerapp
MIGRATION_DATABASE_URL=postgresql+asyncpg://farmerapp:farmerapp@localhost:5432/farmerapp
# Cloud SQL IAM auth (Cloud Run only; set by Terraform, docs/deploy/configuration.md). When
# true the two URLs above are ignored: the Cloud SQL Python Connector logs in as DB_USER with an
# IAM token of the runtime service account, over the instance's private IP.
#DB_IAM_AUTH=false
#DB_INSTANCE_CONNECTION_NAME=           # project:region:instance
#DB_USER=                               # farmerapp-api@<project>.iam (SA email minus .gserviceaccount.com)
#DB_NAME=farmerapp
#DB_IP_TYPE=private                     # private | public | psc
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# pytest uses its own database (created on first run). Optional: default to the two URLs above
# with the database name replaced by farmerapp_test.
#TEST_DATABASE_URL=postgresql+asyncpg://farmerapp_app:farmerapp@localhost:5432/farmerapp_test
#TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://farmerapp:farmerapp@localhost:5432/farmerapp_test

# --- Google Cloud (emulators locally) -----------------------------------------
GCP_PROJECT=farmerapp-local
PUBSUB_EMULATOR_HOST=localhost:8085          # Pub/Sub emulator (compose service `pubsub`)
STORAGE_EMULATOR_HOST=http://localhost:4443  # fake-gcs-server (compose service `gcs`)
PHOTOS_BUCKET=photos                          # fake-gcs bucket locally (compose creates it on demand)
EXPORTS_BUCKET=farmerapp-local-exports
# DX-011 / DX-012 (M7): held-out evaluation manifest, training-set exports and candidate
# on-device models. Terraform sets it from module.storage on the jobs service; the api only
# signs gs:// URIs of approved models out of it.
CORPUS_BUCKET=farmerapp-local-corpus

# --- Blob store + uploads (NF-003 / SEC-016) --------------------------------------
BLOB_STORE=fake_gcs           # fake_gcs (compose `gcs`) | local (directory; unit tests) | gcs (V4 signed URLs; required in prd)
#GCS_SIGNING_SERVICE_ACCOUNT=           # BLOB_STORE=gcs: SA whose IAM signBlob signs URLs (default: the runtime SA)
#BLOB_LOCAL_DIR=/tmp/farmerapp-blobs   # root of the `local` store (defaults to the system temp dir)
#UPLOAD_MAX_BYTES=20971520             # 20 MB per upload
#UPLOAD_CHUNK_SIZE=262144              # 256 KB resumable chunks (NF-003)
#UPLOAD_TTL_SECONDS=900                # pending upload / staged chunks kept 15 min (purge-expired job)
#SIGNED_URL_TTL_SECONDS=900            # 15-minute read URLs
#RULES_DIR=/app/rules                  # VA-001 rule YAML (default: the monorepo rules/)
#IDEMPOTENCY_TTL_SECONDS=86400         # Idempotency-Key responses kept 24 h
#PHONE_VERIFICATION_TTL_SECONDS=1800   # farmer phone verification token (30 min)
#VISIT_CONFIRM_TOKEN_TTL_SECONDS=86400 # FA-016 push / QR confirmation token (24 h)

# --- Providers (mockserver locally; real base URLs per env, keys via Secret Manager) --
SMS_PROVIDER_URL=http://localhost:8090/sms
WHATSAPP_PROVIDER_URL=http://localhost:8090/whatsapp
RAZORPAY_BASE_URL=http://localhost:8090/razorpay
RAZORPAY_KEY_ID=rzp_test_mock                # public key id; the secret is never in env files
#RAZORPAY_KEY_SECRET=                        # FA-021: Secret Manager (razorpay-key-secret) in stg/prd; dev placeholder default
#RAZORPAY_WEBHOOK_SECRET=                    # SEC-023: Secret Manager (razorpay-webhook-secret) in stg/prd; default = mock's test secret
PAYMENT_PROVIDER=razorpay                    # razorpay (mockserver locally) | fake (in-process, tests)
PAYMENT_WEBHOOK_DELIVERY=inline              # inline (apply in the request) | pubsub (payment.webhook -> worker)
#PAYMENT_QR_TTL_SECONDS=900                  # UPI QR / payment link validity

# --- Tracing (NF-014) ------------------------------------------------------------
#OTEL_EXPORTER=none           # none (default, tests) | console (stdout) | gcp (Cloud Trace; stg/prd)
#OTEL_SAMPLE_RATIO=1.0         # head sampling of new traces

# --- PII field encryption (SEC-026) ---------------------------------------------------
#PII_KEK_BACKEND=local         # local (dev/test only) | kms (Cloud KMS; required in prd)
#PII_KMS_KEY_NAME=             # projects/<p>/locations/asia-south1/keyRings/<r>/cryptoKeys/<k>
#PII_LOCAL_KEK=                # base64 of 32 bytes; unset = built-in dev key. Refused in prd
#PII_HASH_PEPPER=              # phone_hash HMAC pepper; Secret Manager in stg/prd (dev default)
#PII_PLAINTEXT_WRITES=false    # rollout safety: also write the legacy plain columns

# --- Play Integrity (SEC-024 server side) --------------------------------------------
#PLAY_INTEGRITY_MODE=off       # off | fake (tests) | google (decodeIntegrityToken; human gate)
#PLAY_INTEGRITY_PACKAGE_NAMES=["in.farmerapp.mitra","in.farmerapp.kisan"]
#PLAY_INTEGRITY_TIMEOUT_S=2.0

# --- Diagnosis engine (M6, SPEC 3: DX-002 .. DX-005) -----------------------------------
# Encoder (DX-002 / DX-005). `fake` = deterministic pixel-DCT encoder (tests, seed, CI eval,
# local); `remote` = the `embed` Cloud Run service (ml/embed), required in prd. The pinned
# name / version are stored on every corpus image and diagnosis; the embed service must answer
# with the same (vectors of two encoders are never mixed).
#DIAGNOSIS_ENCODER=fake                          # fake | remote (prd refuses fake)
#DIAGNOSIS_ENCODER_NAME=siglip-base-patch16-224  # pinned encoder model (remote)
#DIAGNOSIS_ENCODER_VERSION=2024-01               # pinned encoder weights version (remote)
#DIAGNOSIS_EMBED_URL=http://localhost:8095       # embed service base URL (stg/prd: Terraform sets the Cloud Run URL)
#DIAGNOSIS_EMBED_TIMEOUT_S=20
# LLM fallback (DX-004). `claude` = Anthropic Messages API, `fake` = in-process stand-in
# (tests / CI eval; prd refuses it), `off` = every fallback answers "unknown" (agronomist queue).
# Locally without a key use `off` or `fake`.
#DIAGNOSIS_LLM=claude                            # claude | fake | off
DIAGNOSIS_LLM_MODEL=claude-opus-5                # DX-004 model id
#DIAGNOSIS_LLM_MAX_TOKENS=16000                  # retried once with 2x on stop_reason max_tokens
#DIAGNOSIS_LLM_EFFORT=medium                     # low | medium | high (output_config.effort)
# Read by the Anthropic SDK itself (not by Settings). NEVER put a real key here: in stg/prd it
# comes from Secret Manager (secret `anthropic-api-key`, worker SA only) via Terraform.
#ANTHROPIC_API_KEY=
# Delivery: `inline` runs the pipeline inside POST /v1/diagnoses (local / dev); `pubsub`
# publishes diagnosis.requested for the worker push subscription (stg / prd).
#DIAGNOSIS_DELIVERY=inline                       # inline | pubsub
#DIAGNOSIS_KNN_K=20                              # DX-002 neighbours
#DIAGNOSIS_HNSW_EF_SEARCH=40                     # SET LOCAL hnsw.ef_search (docs/perf/M6-knn.md)
#DIAGNOSIS_MAX_ATTEMPTS=5                        # worker deliveries before a failing LLM call -> "unknown"
# Decision thresholds (DX-003: T1, agreement, similarity floor) are NOT a file or env setting:
# they are versioned per crop in the `diagnosis_threshold` table (PUT /v1/diagnoses/thresholds).

# --- Validation review agent (M7 VA-004, docs/prs/M7-rules.md) --------------------------
# Summaries of validation flags for the inbox. `claude` calls the Anthropic Messages API with
# ANTHROPIC_API_KEY (worker and jobs only; Terraform sets `off` in dev, `claude` in stg / prd),
# `fake` is a deterministic in-process stand-in, `off` writes no summary at all.
#FLAG_SUMMARY_LLM=off                            # claude | fake | off
#FLAG_SUMMARY_LLM_MODEL=claude-opus-5            # VA-004 model id
#FLAG_SUMMARY_LLM_MAX_TOKENS=4000                # max_tokens of one summary call (>= 256)

# --- Weather and spray windows (M7 FM-008) ---------------------------------------------
# The server alone calls the provider and sends only the coordinates of the 0.1-degree grid
# cell the farm falls in - never a polygon, a farmer, an id or a header (data residency, see
# docs/prs/M7-farmer-p1-api.md). Open-Meteo is free and needs no key. `fake` is a deterministic
# in-process forecast for tests and offline dev; Terraform never sets the name, so deployments
# get open_meteo. The spray thresholds themselves are tenant settings (`weather.*`), not env.
#WEATHER_PROVIDER=open_meteo                     # open_meteo | fake
#WEATHER_BASE_URL=https://api.open-meteo.com     # forecast API base URL
#WEATHER_TIMEOUT_S=8.0                           # per-call timeout (0 < s <= 30)
#WEATHER_CACHE_TTL_SECONDS=10800                 # forecast cache per grid cell, per instance (3 h)

# --- Diagnosis evaluation and model releases (M7 DX-011, DX-012, AN-007) ----------------
# The held-out, agronomist-labelled set the nightly `diagnosis-evaluate` job scores against: a
# key inside CORPUS_BUCKET (above) or a full gs:// URI; image paths in it are relative to the
# manifest. TODO-HUMAN: real field images are never committed, so until the manifest is
# uploaded the job records a failed run. Candidate on-device models (DX-012) live in the same
# bucket and the api signs 15-minute URLs for the approved one.
#DIAGNOSIS_EVAL_MANIFEST=eval/heldout/manifest.csv
# The crop calendar (FM-007), outbreak rule (FM-009 / DX-013) and the evaluation alert
# threshold (DX-011) are per-tenant settings (`calendar_reminders.*`, `quiet_hours`,
# `outbreak.*`, `diagnosis_evaluation.*` via PATCH /v1/settings), not deployment env.

# --- Push, road snapping, meeting QR (M7 field P1: FA-007, VV-006, FA-027) --------------
# FCM HTTP v1 with the runtime service account's OAuth token - there is no server key. `off`
# leaves notification rows pending (the in-app inbox still lists them); `fcm` is a human gate
# (the Firebase project). prd refuses `fake`.
#PUSH_PROVIDER=off                               # fcm | fake | off
#FCM_PROJECT=                                    # Firebase project id (default: GCP_PROJECT)
#NOTIFY_MAX_ATTEMPTS=5                           # push attempts before a row is 'failed' (1..20)
#ROAD_SNAPPER=off                                # off (haversine + filters) | google (Roads API)
#GOOGLE_MAPS_API_KEY=                            # ROAD_SNAPPER=google: Secret Manager, never here
#MEETING_QR_TTL_SECONDS=300                      # FA-027 attendance QR validity (30..3600 s)

# --- Email (WC-013 scheduled reports, AN-015 owner report, ST-008 accounting export) ----
# `log` writes an `email_logged` line and sends nothing - the default everywhere until a
# provider exists (human gate). `fake` keeps messages in memory (tests). `smtp` uses the
# EMAIL_SMTP_* settings, `sendgrid` the SendGrid-style HTTP API with EMAIL_API_KEY.
#EMAIL_PROVIDER=log                              # log | fake | smtp | sendgrid
#EMAIL_FROM=reports@farmerapp.local              # From address (users carry no email address)
#EMAIL_API_URL=https://api.sendgrid.com/v3/mail/send
#EMAIL_API_KEY=                                  # sendgrid: Secret Manager in stg / prd
#EMAIL_SMTP_HOST=localhost
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USERNAME=
#EMAIL_SMTP_PASSWORD=                            # Secret Manager in stg / prd; never in a file
#EMAIL_SMTP_STARTTLS=true
#EMAIL_TIMEOUT_S=20.0

# --- Auth (FA-001 / SEC-020 / SEC-021) ------------------------------------------
OTP_PROVIDER=mockserver       # mockserver | fake (in-process, tests). Real gateway adapter per env.
OTP_DEV_CODE=123456           # fixed OTP accepted locally/dev only; MUST be unset in prd (startup check)
OTP_PEPPER=dev-only-otp-pepper-not-a-secret            # HMAC pepper for OTP hashes; Secret Manager in stg/prd
#OTP_TTL_SECONDS=300                   # OTP validity (5 min)
#OTP_MAX_ATTEMPTS=5                    # wrong attempts before lockout
#OTP_LOCKOUT_SECONDS=900               # lockout after too many misses (15 min)
#OTP_MAX_RESENDS=3                     # resends per window
#OTP_RESEND_WINDOW_SECONDS=900         # resend window (15 min)
#OTP_RESEND_AFTER_SECONDS=30           # client resend timer hint
#OTP_WHATSAPP_FALLBACK_SECONDS=30      # WhatsApp if SMS delivery is not confirmed by then
# SEC-021 SMS pumping protection (farmerapp/auth/otp_abuse.py). An OTP send costs money and
# pays an attacker; these four layers run before any SMS leaves. Defaults are the intended
# production values — widen them deliberately, not by accident.
#OTP_ALLOWED_COUNTRY_CODES=["+91"]     # E.164 prefixes we will send to (India only)
#OTP_BLOCKED_COUNTRY_CODES=[]          # refused even if the allow list would permit them
#OTP_MAX_SENDS_PER_PHONE_DAY=10        # per number per 24 h, across purposes
#OTP_MAX_SENDS_PER_IP_HOUR=20          # per client IP per hour, across numbers
#OTP_ABUSE_BLOCK_SECONDS=86400         # first block; doubles per strike, capped at 30 days
#OTP_COST_ALERT_PER_HOUR=200           # tenant sends/hour that log otp_cost_alert (never blocks)
#OTP_COST_BLOCK_PER_HOUR=2000          # tenant sends/hour at which new sends are refused
JWT_SIGNING_KEY=dev-only-jwt-signing-key-not-a-secret  # HS256 key; Secret Manager in stg/prd (>= 32 chars)
#JWT_ALGORITHM=HS256                   # only HS256 today
#JWT_ISSUER=farmerapp
#ACCESS_TOKEN_TTL_SECONDS=900          # 15 min
#REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days (rotated on every refresh)
#STEP_UP_TOKEN_TTL_SECONDS=300         # SEC-028 re-auth token (60..900 s)
#SECURITY_CACHE_TTL_SECONDS=30         # WC-011 / SEC-025 device-status cache (0..60 s)
# NF-013 DPDP grievance redressal: the contact GET /v1/privacy/contact returns and the apps
# show. Not secrets. The real name and address are a legal review (TODO-LEGAL, docs/dpdp.md).
#GRIEVANCE_OFFICER_NAME=Grievance Officer
#GRIEVANCE_OFFICER_EMAIL=grievance@farmerapp.in
#GRIEVANCE_OFFICER_PHONE=+911800000000
#GRIEVANCE_RESPONSE_DAYS=30            # we answer within this many days (1..90)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]   # console origins (JSON list)

# --- Mockserver (docker/mockserver) --------------------------------------------
MOCK_RAZORPAY_WEBHOOK_SECRET=test_webhook_secret   # test-only HMAC secret for simulated webhooks
MOCK_RAZORPAY_KEY_ID=rzp_test_mock

# --- Tooling -------------------------------------------------------------------
SKIP_AUDIT=0                  # 1 skips pip-audit in `make check-api` (offline)
